    public static SCCustomerExcelImportRun find(RefRecId _recId, boolean _forUpdate = false)
    {
        SCCustomerExcelImportRun importRun;

        if (_recId)
        {
            importRun.selectForUpdate(_forUpdate);
            select firstonly importRun where importRun.RecId == _recId;
        }

        return importRun;
    }

