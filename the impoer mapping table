		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (!this.TargetFieldName)
        {
            ret = checkFailed("@SCMedadLabels:MappingTargetFieldRequired");
        }

        if (ret && !SCCustomerExcelImportHelper::isImportableStagingField(this.TargetFieldName))
        {
            ret = checkFailed(strFmt("@SCMedadLabels:UnsupportedMappingField", this.TargetFieldName));
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByTargetField</Name>
				<Source><![CDATA[
    public static SCCustomerExcelMapping findByTargetField(str _fieldName, boolean _forUpdate = false)
    {
        SCCustomerExcelMapping mapping;

        if (_fieldName)
        {
            mapping.selectForUpdate(_forUpdate);
            select firstonly mapping
                where mapping.TargetFieldName == _fieldName;
        }

        return mapping;
    }

]]></Source>
			</Method>
			<Method>
				<Name>generateMissingFields</Name>
				<Source><![CDATA[
    /// <summary>
    /// Creates mapping records for importable <c>SCAutomatedImportCustomers</c> fields
    /// that are not already present. Existing records are left unchanged, including
    /// their Excel header names.
    /// </summary>
    /// <returns>The number of mapping records that were created.</returns>
    public static int generateMissingFields()
    {
        DictTable dictTable = new DictTable(tableNum(SCAutomatedImportCustomers));
        FieldId fieldId = dictTable.fieldNext(0);
        SCCustomerExcelMapping mapping;
        SCCustomerExcelMapping existing;
        int created;

        ttsbegin;

        while (fieldId)
        {
            str fieldName = fieldId2Name(tableNum(SCAutomatedImportCustomers), fieldId);

            if (SCCustomerExcelImportHelper::isImportableStagingField(fieldName))
            {
                existing = SCCustomerExcelMapping::findByTargetField(fieldName);

                if (!existing.RecId)
                {
                    mapping.clear();
                    mapping.TargetFieldName = fieldName;
                    mapping.ExcelHeaderName = '';
                    mapping.insert();
                    created++;
                }
            }

            fieldId = dictTable.fieldNext(fieldId);
        }

        ttscommit;

        return created;
    }

]]></Source>
			</Method>
